# Optional runtime overrides for shell scripts or CI wrappers.
# The Python CLI flags remain the source of truth.
MOMENTUM_START=2017-01-01
MOMENTUM_END=2026-01-01
MOMENTUM_TRAIN_END=2022-12-31
MOMENTUM_TEST_START=2023-01-01
MOMENTUM_TOP_N=2
MOMENTUM_ENTRY_COST=0.001
MOMENTUM_EXIT_COST=0.001
MOMENTUM_N_JOBS=1
MOMENTUM_MODEL_TYPE=random_forest
MOMENTUM_DASHBOARD_HOST=127.0.0.1
MOMENTUM_DASHBOARD_PORT=8010

# Web app runtime.
ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_ACCESS_CODE=replace-with-admin-invite-code
RATE_LIMIT_PER_MINUTE=90
MOMENTUM_DB_PATH=data/momentum_app.sqlite3

# Optional Google Identity Services wiring for production frontends.
GOOGLE_CLIENT_ID=

# Optional email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
